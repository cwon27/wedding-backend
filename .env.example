# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다.

# Supabase > Project Settings > Database > Connection string > JDBC, "Session pooler"
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxxxx
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DEVICE_COOKIE_SECURE=false

# 이미지 생성기. fake = AI 호출 없이 더미 이미지 (개발용, 비용 0)
# 1단계 사진 → 후보: fake | gemini
CANDIDATE_GENERATOR=fake
# 2단계 후보 → 걷기 시트: fake (pixellab 예정)
SPRITE_GENERATOR=fake

# Google AI Studio 에서 발급. CANDIDATE_GENERATOR=gemini 일 때 필요 (선불 크레딧 충전 필요)
GEMINI_API_KEY=
